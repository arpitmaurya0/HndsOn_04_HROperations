@model ClassLibrary.Models.Employee

@{
    ViewData["Title"] = "AddEmp";
}

<h1>Add Employee</h1>

<h4>Employee</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddEmp">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EmpName" class="control-label"></label>
                <input asp-for="EmpName" class="form-control" />
                <span asp-validation-for="EmpName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmpEmail" class="control-label"></label>
                <input asp-for="EmpEmail" class="form-control" />
                <span asp-validation-for="EmpEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Empdept" class="control-label"></label>
                <select asp-for="Empdept" class="form-control">
                    <option value="">--Select--</option>
                    <option value="HR">HR</option>
                    <option value="IT">IT</option>
                    <option value="Marketing">Marketing</option>
                    <option value="finance">Finance</option>
                </select>
                <span asp-validation-for="Empdept" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmpContact" class="control-label"></label>
                <input asp-for="EmpContact" class="form-control" />
                <span asp-validation-for="EmpContact" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
