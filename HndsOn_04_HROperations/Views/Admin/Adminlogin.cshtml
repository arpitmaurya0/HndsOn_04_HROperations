@model ClassLibrary.Models.Admin

@{
    ViewData["Title"] = "Adminlogin";
}

<h1>Admin login</h1>

<h4>Admin</h4>
<h3 class="alert-danger">@ViewData["error"]</h3>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Adminlogin">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="AdmUserName" class="control-label"></label>
                <input asp-for="AdmUserName" class="form-control" />
                <span asp-validation-for="AdmUserName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdmPassword" class="control-label"></label>
                <input asp-for="AdmPassword" class="form-control" />
                <span asp-validation-for="AdmPassword" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
